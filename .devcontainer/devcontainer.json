{
  // Run MotionWorkflow in GitHub Codespaces: works from a phone or any browser.
  // Open: https://codespaces.new/shawnzanco972/Motionworkflow  (then wait ~3 minutes the first time)
  "name": "MotionWorkflow",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "containerEnv": {
    // The app normally only answers on localhost; this lets the Codespace's private
    // forwarded address (only you, signed in to GitHub, can open it) reach it.
    "MW_ALLOWED_HOSTS": ".app.github.dev"
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq ffmpeg >/dev/null && bash setup.sh",
  "postStartCommand": "bash scripts/codespace-start.sh",
  "postAttachCommand": "bash scripts/codespace-start.sh --show",
  "forwardPorts": [8770],
  "portsAttributes": {
    "8770": { "label": "MotionWorkflow", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["docs/PHONE.md"] }
  }
}
