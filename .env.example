# MotionWorkflow settings. Copy to .env (setup.sh does this) and fill in what you have.
# Never commit or share a filled-in .env. Every key is optional: without keys the app
# runs with free Pollinations images and offline mock media so you can try everything.

# --- Provider keys --------------------------------------------------------------
# fal.ai: one key for most cheap image/video/voice/swap models (recommended first key)
# https://fal.ai/dashboard/keys
FAL_KEY=
# Replicate: alternative model catalog. https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Enhancor: Seedance 2.5 character swap (the Genjutsu engine). https://app.enhancor.ai/api-dashboard
ENHANCOR_API_KEY=
# Anthropic: Claude writes the scripts for Short Maker. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Spending guard (USD, estimates) --------------------------------------------
MW_DAILY_BUDGET=10.00
MW_MAX_COST_PER_JOB=3.00
# Ask for confirmation before starting a job estimated at or above this:
MW_CONFIRM_ABOVE=0.50
# free | budget | standard | premium
MW_DEFAULT_TIER=budget
# How many shots generate at once
MW_MAX_PARALLEL=3

# --- Script writer ---------------------------------------------------------------
# Used for standard/premium tiers; free/budget tiers use the _BUDGET model.
MW_PLANNER_MODEL=claude-opus-5-5
MW_PLANNER_MODEL_BUDGET=claude-haiku-5-5
# Fresh-eyes reviewer that scores finished shorts from frames only (same tier rule).
MW_REVIEWER_MODEL=claude-opus-5-5
MW_REVIEWER_MODEL_BUDGET=claude-haiku-5-5

# --- Enhancor only ----------------------------------------------------------------
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
# Enhancor requires a webhook. Leave blank to auto-start a callback-only cloudflared
# tunnel (install cloudflared), or set your own HTTPS receiver.
ENHANCOR_WEBHOOK_URL=
# Public hosts used to give Enhancor (and large fal uploads) a URL for your files.
# WARNING: anyone with the link can download; catbox links are permanent.
MEDIA_HOST=tmpfiles
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=

# Set to 0 to hide offline mock models once you have real keys.
MW_ALLOW_MOCK=1
